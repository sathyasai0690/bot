def load_kite_credentials():
    """Load API key + secret from kite_creds.json or env vars."""
    creds_file = 'kite_creds.json'
    if os.path.exists(creds_file):
        with open(creds_file) as f:
            c = json.load(f)
        return c.get('api_key'), c.get('api_secret')
    return os.environ.get('KITE_API_KEY'), os.environ.get('KITE_API_SECRET')


def kite_login():
    """
    Standard Kite login flow:
      1. Check if today's access_token exists and is valid
      2. If not, open browser for user to get request_token
      3. Exchange request_token for access_token
      4. Save access_token with today's date for reuse
    """
    api_key, api_secret = load_kite_credentials()
    if not api_key or not api_secret:
        log.error('Kite credentials missing. Create kite_creds.json with api_key/api_secret.')
        sys.exit(1)

    B2['KITE_API_KEY'] = api_key
    B2['KITE_API_SECRET'] = api_secret

    kite = KiteConnect(api_key=api_key)
    token_file = B2['KITE_TOKEN_FILE']
    today = datetime.date.today().isoformat()

    # Try cached token first
    if os.path.exists(token_file):
        try:
            with open(token_file) as f:
                saved = json.load(f)
            if saved.get('date') == today:
                kite.set_access_token(saved['access_token'])
                # Verify still valid by making a cheap call
                try:
                    kite.profile()
                    log.info('Kite: using cached access_token from today.')
                    return kite
                except Exception:
                    log.info('Cached token rejected — will fetch a new one.')
        except Exception:
            pass

    # Need fresh login
    login_url = kite.login_url()
    print('\n' + '=' * 70)
    print('KITE LOGIN REQUIRED')
    print('=' * 70)
    print('Open this URL in browser, log in, then paste back the request_token:')
    print(login_url)
    print('=' * 70)
    try:
        webbrowser.open(login_url)
    except Exception:
        pass
    req_token = input('Paste request_token here: ').strip()

    try:
        data = kite.generate_session(req_token, api_secret=api_secret)
        access_token = data['access_token']
        kite.set_access_token(access_token)
        with open(token_file, 'w') as f:
            json.dump({'date': today, 'access_token': access_token}, f)
        log.info('Kite: new access_token obtained and saved.')
        return kite
    except Exception as e:
        log.error('Kite login failed: ' + str(e))
        sys.exit(1)


