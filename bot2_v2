# SECTION 18 — MAIN
# ═══════════════════════════════════════════════════════════════════════
def main():
    log.info('╔' + '═' * 65 + '╗')
    log.info('║ BOT2 v2 — STARTING (SL Rs.1K, IV+delta filters, split cooldown)  ║')
    log.info('║ Mode: ' + ('LIVE' if B2['LIVE_MODE'] else 'PAPER').ljust(60) + '║')
    log.info('║ Capital: Rs.' + str(B2['TOTAL_CAPITAL']).ljust(54) + '║')
    log.info('╚' + '═' * 65 + '╝')

    STATE['session_date']  = datetime.date.today()
    STATE['session_start'] = datetime.datetime.now()

    kite = kite_login()
    STATE['kite'] = kite

    # Build universe
    STATE['universe'] = build_universe(kite)
    if not STATE['universe']:
        log.error('Universe empty — aborting.')
        return

    # Pre-market run (only if past 09:15 today)
    now = datetime.datetime.now().time()
    if now >= datetime.time(9, 15):
        run_pre_market(kite)
    else:
        log.info('Pre-market not yet — will run at 09:25.')

    # Schedule jobs
    schedule.every(3).minutes.do(trade_loop, kite=kite)
    schedule.every(B2['TOP_RESCORE_SECS']).seconds.do(rescore_top_n, kite=kite)
    schedule.every(B2['FULL_RESCORE_SECS']).seconds.do(full_rescore, kite=kite)
    schedule.every().day.at('09:25').do(run_pre_market, kite=kite)
    schedule.every().day.at(B2['SQUAREOFF_TIME']).do(square_off, kite=kite)
    schedule.every(30).seconds.do(write_heartbeat)

    log.info('Scheduler started.')
    while True:
        try:
            schedule.run_pending()
            time.sleep(1)
        except KeyboardInterrupt:
            log.info('Stopping bot2...')
            for pos_id in list(STATE['positions'].keys()):
                close_position(kite, pos_id, 'Bot stopped (KeyboardInterrupt)')
            write_excel_report(eod=True)
            log.info('Bot2 stopped cleanly.')
            break
        except Exception as e:
            log.error('Scheduler error: ' + str(e))
            log.error(traceback.format_exc())
            time.sleep(5)


if __name__ == '__main__':
    main()
