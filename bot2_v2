    for p in STATE['top_picks'][:5]:
        log.info('  ' + p['symbol'] + ' ' + p['direction']
                 + ' score=' + str(p['score']) + ' ' + str(p['components']))


def rebuild_top_picks():
    """Sort all_scores by score DESC and store top picks."""
    sorted_picks = sorted(STATE['all_scores'].values(),
                          key=lambda x: x['score'], reverse=True)
    STATE['top_picks'] = sorted_picks
    return sorted_picks


def rescore_top_n(kite):
    """Every 3 min — re-score the top N stocks to refresh ranking."""
    if not STATE['pre_market_done']:
        return
    top_n = B2['TOP_PICKS_REFRESH_N']
    top_stocks = STATE['top_picks'][:top_n]
    log.info('Top-' + str(top_n) + ' rescore...')
    for pick in top_stocks:
        stock = next((s for s in STATE['universe']
                      if s['symbol'] == pick['symbol']), None)
        if not stock:
            continue
        result = score_stock(kite, stock)
        if result:
            STATE['all_scores'][result['symbol']] = result
        time.sleep(0.05)
    rebuild_top_picks()
    STATE['last_top_rescore'] = datetime.datetime.now()


def full_rescore(kite):
    """Every 15 min — re-score the entire universe."""
    if not STATE['pre_market_done']:
        return
    log.info('FULL universe rescore (' + str(len(STATE['universe'])) + ' stocks)...')
    refresh_sentiment(kite)
    for stock in STATE['universe']:
        result = score_stock(kite, stock)
        if result:
            STATE['all_scores'][result['symbol']] = result
        time.sleep(0.05)
    rebuild_top_picks()
    STATE['last_full_rescore'] = datetime.datetime.now()
    log.info('Full rescore complete. New top 5:')
    for p in STATE['top_picks'][:5]:
        log.info('  ' + p['symbol'] + ' ' + p['direction']
                 + ' score=' + str(p['score']))


