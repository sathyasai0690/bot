def refresh_sentiment(kite):
    """
    Compute global sentiment from Nifty + BankNifty + VIX.
    Returns BULLISH / BEARISH / NEUTRAL.
    Also captures Nifty session open for move-from-open calc.
    """
    bull = bear = 0
    components = {}

    # Nifty 50
    try:
        df = fetch_kite(kite, INSTRUMENT_TOKENS['NIFTY_50'], days=2, interval='5minute')
        if df is not None and not df.empty:
            today = datetime.date.today()
            df_today = df[df.index.date == today]
            if not df_today.empty:
                STATE['nifty_session_open'] = float(df_today['open'].iloc[0])
                STATE['nifty_current'] = float(df_today['close'].iloc[-1])
                df_prev = df[df.index.date < today]
                if not df_prev.empty:
                    prev_close = float(df_prev['close'].iloc[-1])
                    chg = (STATE['nifty_current'] - prev_close) / prev_close * 100
                    components['nifty_pct'] = round(chg, 2)
                    if chg > 0.3: bull += 1
                    elif chg < -0.3: bear += 1
    except Exception as e:
        log.warning('Nifty sentiment fetch failed: ' + str(e))

    # BankNifty
    try:
        df = fetch_kite(kite, INSTRUMENT_TOKENS['BANKNIFTY'], days=2, interval='5minute')
        if df is not None and not df.empty:
            today = datetime.date.today()
            df_today = df[df.index.date == today]
            df_prev = df[df.index.date < today]
            if not df_today.empty and not df_prev.empty:
                cur = float(df_today['close'].iloc[-1])
                prev = float(df_prev['close'].iloc[-1])
                chg = (cur - prev) / prev * 100
                components['banknifty_pct'] = round(chg, 2)
                if chg > 0.3: bull += 1
                elif chg < -0.3: bear += 1
    except Exception:
        pass

    # VIX
    try:
        df = fetch_kite(kite, INSTRUMENT_TOKENS['INDIA_VIX'], days=2, interval='5minute')
        if df is not None and not df.empty:
            STATE['vix_current'] = float(df['close'].iloc[-1])
            components['vix'] = round(STATE['vix_current'], 2)
            # VIX inversely correlates: rising VIX = bearish risk
            today = datetime.date.today()
            df_today = df[df.index.date == today]
            df_prev = df[df.index.date < today]
            if not df_today.empty and not df_prev.empty:
                cur = float(df_today['close'].iloc[-1])
                prev = float(df_prev['close'].iloc[-1])
                vix_chg = (cur - prev) / prev * 100
                components['vix_pct'] = round(vix_chg, 2)
                if vix_chg > 3: bear += 1
                elif vix_chg < -3: bull += 1

        # v2 FIX F: compute IV rank from VIX 60-day daily range
        df_vix_daily = fetch_kite(kite, INSTRUMENT_TOKENS['INDIA_VIX'],
                                  days=90, interval='day')
        if df_vix_daily is not None and len(df_vix_daily) >= 30:
            recent = df_vix_daily.tail(60)  # last 60 sessions
            vix_min = float(recent['low'].min())
            vix_max = float(recent['high'].max())
            vix_now = STATE['vix_current']
            if vix_max > vix_min:
                iv_rank = int(((vix_now - vix_min) / (vix_max - vix_min)) * 100)
                iv_rank = max(0, min(100, iv_rank))
                STATE['iv_rank'] = iv_rank
                components['iv_rank'] = iv_rank
    except Exception:
        pass

    if bull >= 2 and bull > bear:
        sentiment = 'BULLISH'
    elif bear >= 2 and bear > bull:
        sentiment = 'BEARISH'
    else:
        sentiment = 'NEUTRAL'

    STATE['global_sentiment'] = sentiment
    STATE['sentiment_components'] = components
    log.info('Sentiment: ' + sentiment + '  bull=' + str(bull) + ' bear=' + str(bear)
             + '  ' + str(components))
    return sentiment


