def fetch_kite(kite, instrument_token, days=2, interval='3minute'):
    """Fetch historical OHLCV. Returns DataFrame or None."""
    try:
        end = datetime.datetime.now()
        start = end - datetime.timedelta(days=days)
        bars = kite.historical_data(instrument_token, start, end, interval)
        if not bars:
            return None
        df = pd.DataFrame(bars)
        df['date'] = pd.to_datetime(df['date'])
        df = df.set_index('date')
        return df
    except Exception as e:
        log.warning('fetch_kite error token=' + str(instrument_token)
                    + ' interval=' + interval + ': ' + str(e))
        return None


def get_ltp_safe(kite, symbol):
    """Get live LTP for a tradingsymbol, e.g. 'NSE:TCS'."""
    try:
        r = kite.ltp([symbol])
        return r[symbol]['last_price']
    except Exception as e:
        log.warning('LTP fetch fail for ' + symbol + ': ' + str(e))
        return None


