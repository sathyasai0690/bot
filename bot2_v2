# SECTION 11 — OPTION SYMBOL SELECTION
# ═══════════════════════════════════════════════════════════════════════
def find_option_symbol(kite, stock_name, direction):
    """
    Find the right ATM-ish option strike that meets liquidity criteria.
    Returns dict with symbol, strike, opt_ltp, opt_token, lot_size or None.
    """
    try:
        instruments = kite.instruments('NFO')
    except Exception as e:
        log.warning('NFO instruments fail: ' + str(e))
        return None

    today = datetime.date.today()
    # Filter for this stock + direction + nearest valid expiry
    candidates = []
    for inst in instruments:
        if inst.get('name') != stock_name:
            continue
        if inst.get('instrument_type') != direction:
            continue
        exp = inst.get('expiry')
        if not exp:
            continue
        days_to_exp = (exp - today).days
        if days_to_exp < B2['EXPIRY_MIN_DAYS']:
            continue
        candidates.append(inst)

    if not candidates:
        log.warning('No option candidates for ' + stock_name + ' ' + direction)
        return None

    # Sort by expiry (nearest valid first)
    candidates.sort(key=lambda x: x['expiry'])
    earliest_expiry = candidates[0]['expiry']
    nearest_exp = [c for c in candidates if c['expiry'] == earliest_expiry]

    # Get stock LTP for ATM calculation
    stock_ltp = get_ltp_safe(kite, 'NSE:' + stock_name)
    if not stock_ltp:
        return None

    # Sort strikes by distance from spot
    nearest_exp.sort(key=lambda x: abs(x['strike'] - stock_ltp))

    # Walk through nearest strikes, pick first that meets liquidity + premium + delta
    for opt in nearest_exp[:8]:
        opt_symbol = opt['tradingsymbol']
        try:
            quote = kite.quote(['NFO:' + opt_symbol])
            q = quote['NFO:' + opt_symbol]
            opt_ltp = q.get('last_price', 0)
            opt_oi = q.get('oi', 0)
            opt_vol = q.get('volume', 0)
        except Exception:
            continue
        if opt_ltp < B2['OPTION_PREMIUM_MIN'] or opt_ltp > B2['OPTION_PREMIUM_MAX']:
            continue
        if opt_oi < B2['MIN_OPTION_OI'] or opt_vol < B2['MIN_OPTION_VOLUME']:
            continue

        # v2 FIX F: delta filter — reject if too far OTM
        days_to_exp = (opt['expiry'] - today).days
        est_delta = estimate_delta(stock_ltp, opt['strike'], opt_ltp, direction, days_to_exp)
        min_delta = B2.get('MIN_OPTION_DELTA', 0.40)
        if abs(est_delta) < min_delta:
            log.info('  Skip ' + opt_symbol + ' — |delta|=' + str(round(est_delta, 2))
                     + ' < ' + str(min_delta) + ' (too far OTM)')
            continue

        return {
            'symbol':    opt_symbol,
            'strike':    opt['strike'],
            'opt_ltp':   opt_ltp,
            'opt_token': opt['instrument_token'],
            'lot_size':  opt['lot_size'],
            'expiry':    opt['expiry'].isoformat(),
            'delta':     round(est_delta, 2),
        }

    log.info('No liquid option found for ' + stock_name + ' ' + direction)
    return None


def estimate_delta(stock_ltp, strike, opt_ltp, direction, days_to_exp):
    """
    Rough delta estimator (no external Greeks library needed).
    Uses moneyness (S vs K) + time value as proxy.
    Good enough for filter decisions (accept/reject) — not for hedging.
    """
    try:
        if direction == 'CE':
            intrinsic = max(0.0, stock_ltp - strike)
            moneyness = (stock_ltp - strike) / strike  # + = ITM
        else:  # PE
            intrinsic = max(0.0, strike - stock_ltp)
            moneyness = (strike - stock_ltp) / strike  # + = ITM

        # Delta rough curve:
        #   deep ITM ~0.9, ATM ~0.5, deep OTM ~0.1
        # moneyness > +5% (deep ITM) → ~0.85
        # moneyness  0    (ATM)      → ~0.50
        # moneyness < -5% (deep OTM) → ~0.15
        if moneyness >= 0.05:
            delta = 0.75 + min(0.20, moneyness * 2)  # 0.75-0.95
        elif moneyness >= 0:
            delta = 0.50 + moneyness * 5  # 0.50-0.75
        elif moneyness >= -0.05:
            delta = 0.50 + moneyness * 5  # 0.25-0.50 (negative moneyness)
        else:
            delta = max(0.05, 0.25 + (moneyness + 0.05) * 2)  # 0.05-0.25

        # Adjust for time — very short expiry pushes delta toward 0 or 1
        # (not doing full model — just avoid ridiculous outputs)
        delta = max(0.05, min(0.98, delta))
        return delta if direction == 'CE' else -delta  # PE returns negative
    except Exception:
        return 0.5  # fallback: assume ATM


