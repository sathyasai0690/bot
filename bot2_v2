# SECTION 12 — PAPER TRADE ENGINE
# ═══════════════════════════════════════════════════════════════════════
def place_buy(kite, opt_symbol, qty, opt_ltp):
    """
    Place a BUY order.
      Paper mode: simulate fill at LTP (no slippage).
      Live mode:  send real Kite order with limit at LTP * 1.05.
    Returns (success, fill_price).
    """
    if not B2['LIVE_MODE']:
        log.info('PAPER BUY: ' + opt_symbol + ' qty=' + str(qty)
                 + ' @ Rs.' + str(round(opt_ltp, 2)))
        return True, opt_ltp

    try:
        limit_price = round(opt_ltp * 1.05, 1)  # 5% above LTP, rounded to 0.10
        order_id = kite.place_order(
            variety='regular',
            exchange='NFO',
            tradingsymbol=opt_symbol,
            transaction_type='BUY',
            quantity=qty,
            product='MIS',
            order_type='LIMIT',
            price=limit_price,
        )
        log.info('LIVE BUY order_id=' + str(order_id))
        # Wait briefly and check fill
        time.sleep(2)
        orders = kite.orders()
        for o in orders:
            if o.get('order_id') == order_id and o.get('status') == 'COMPLETE':
                return True, o.get('average_price', opt_ltp)
        log.warning('LIVE BUY not filled within 2s')
        return False, None
    except Exception as e:
        log.error('LIVE BUY failed: ' + str(e))
        return False, None


def place_sell(kite, opt_symbol, qty, opt_ltp):
    """
    Place a SELL order. Paper mode simulates fill at LTP.
    """
    if not B2['LIVE_MODE']:
        log.info('PAPER SELL: ' + opt_symbol + ' qty=' + str(qty)
                 + ' @ Rs.' + str(round(opt_ltp, 2)))
        return True, opt_ltp

    try:
        limit_price = round(opt_ltp * 0.95, 1)  # 5% below LTP for fast fill
        order_id = kite.place_order(
            variety='regular',
            exchange='NFO',
            tradingsymbol=opt_symbol,
            transaction_type='SELL',
            quantity=qty,
            product='MIS',
            order_type='LIMIT',
            price=limit_price,
        )
        log.info('LIVE SELL order_id=' + str(order_id))
        time.sleep(2)
        orders = kite.orders()
        for o in orders:
            if o.get('order_id') == order_id and o.get('status') == 'COMPLETE':
                return True, o.get('average_price', opt_ltp)
        # Try MARKET as fallback
        log.warning('SELL not filled — falling back to MARKET')
        kite.place_order(
            variety='regular', exchange='NFO',
            tradingsymbol=opt_symbol, transaction_type='SELL',
            quantity=qty, product='MIS', order_type='MARKET',
        )
        time.sleep(2)
        return True, opt_ltp * 0.95
    except Exception as e:
        log.error('LIVE SELL failed: ' + str(e))
        return False, None


