def run_pre_market(kite):
    """09:25 pre-market run — score full universe, identify top picks."""
    log.info('=' * 60)
    log.info('PRE-MARKET RUN — full universe scoring')
    log.info('=' * 60)
    refresh_sentiment(kite)

    scores = {}
    for stock in STATE['universe']:
        result = score_stock(kite, stock)
        if result:
            scores[result['symbol']] = result
        time.sleep(0.1)

    STATE['all_scores'] = scores
    rebuild_top_picks()

    STATE['pre_market_done'] = True
    STATE['last_top_rescore']  = datetime.datetime.now()
