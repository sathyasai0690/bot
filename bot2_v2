# SECTION 8 — HISTORIC PATTERN MATCH (the 7-of-10 rule)
# ═══════════════════════════════════════════════════════════════════════
def historic_pattern_score(kite, stock, current_move_pct, direction):
    """
    Look back 10 trading days. Find instances where the stock had a similar
    intraday move (same direction, within ±20% magnitude). For each instance,
    check if the relevant option (call for up-move, put for down-move) gained
    Rs.1,000 within 15 min of that move.

    Simplified version (doesn't fetch historical option prices — too expensive):
      Use stock's own subsequent move as a proxy:
        After the matching move, did stock continue in same direction by at
        least 0.5% within 15 min? (≈ Rs.1,000 option gain on typical delta 0.5)

    Returns: (score 0-3, win_count, sample_size)
    """
    try:
        df = fetch_kite(kite, stock['token'], days=15, interval='3minute')
        if df is None or len(df) < 50:
            return 0, 0, 0

        # Compute % change between each 3-min close and 15 min later (5 bars)
        df['future_close'] = df['close'].shift(-5)
        df['fwd_pct'] = (df['future_close'] - df['close']) / df['close'] * 100

        # Current candle return (just-completed 3-min bar)
        df['cur_pct'] = (df['close'] - df['open']) / df['open'] * 100

        # Filter: candles similar to current move
        # Similarity = same direction, magnitude within ±20%
        target_low  = current_move_pct * 0.8
        target_high = current_move_pct * 1.2
        if current_move_pct >= 0:
            mask = (df['cur_pct'] >= target_low) & (df['cur_pct'] <= target_high)
        else:
            mask = (df['cur_pct'] <= target_low) & (df['cur_pct'] >= target_high)

        similar = df[mask].dropna(subset=['fwd_pct'])
        if len(similar) == 0:
            return 0, 0, 0

        # Take the most recent 10 instances
        recent = similar.tail(B2['HISTORIC_LOOKBACK_DAYS'])
        n = len(recent)

        # "Win" = subsequent 15-min move continues in trade direction by ≥ 0.5%
        if direction == 'CE':
            wins = (recent['fwd_pct'] >= 0.5).sum()
        else:  # PE
            wins = (recent['fwd_pct'] <= -0.5).sum()

        # v2 FIX E: require statistically meaningful sample size
        # Previously "n < 3 → return 0" — too small for reliable signal
        # Now require ≥7 similar historical instances before awarding any score
        min_samples = B2.get('HISTORIC_MIN_SAMPLES', 7)
        if n < min_samples:
            return 0, wins, n  # insufficient sample size

        win_rate = wins / n
        if win_rate >= 0.7:    return 3, wins, n
        elif win_rate >= 0.5:  return 2, wins, n
        elif win_rate >= 0.3:  return 1, wins, n
        else:                  return 0, wins, n
    except Exception as e:
        log.warning('historic_pattern_score error ' + stock['symbol'] + ': ' + str(e))
        return 0, 0, 0


