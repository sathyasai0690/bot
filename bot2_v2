# SECTION 9 — SCORING ENGINE (4 components → 0-8 pts)
# ═══════════════════════════════════════════════════════════════════════
def score_stock(kite, stock):
    """
    Score a single stock. Returns {symbol, direction, score, components, ltp}.
    Components:
      historic_pattern (3) + sentiment_align (2) + volume (2) + sector (1) = 8
    Direction: CE if stock moving up + sentiment OK, PE if stock down + sentiment OK.
    """
    sym = stock['symbol']
    components = {'historic': 0, 'sentiment': 0, 'volume': 0, 'sector': 0}

    # Need today's data
    df = fetch_kite(kite, stock['token'], days=2, interval='3minute')
    if df is None or df.empty:
        return None

    today = datetime.date.today()
    df_today = df[df.index.date == today]
    if df_today.empty or len(df_today) < 2:
        return None

    open_price = float(df_today['open'].iloc[0])
    last_close = float(df_today['close'].iloc[-1])
    last_open  = float(df_today['open'].iloc[-1])
    move_pct = (last_close - open_price) / open_price * 100  # from session open
    last_candle_pct = (last_close - last_open) / last_open * 100  # last 3-min bar

    # Direction inferred from intraday trend
    direction = None
    if move_pct > 0.3:
        direction = 'CE'
    elif move_pct < -0.3:
        direction = 'PE'
    else:
        # Too sideways; use sentiment as tiebreaker
        if STATE['global_sentiment'] == 'BULLISH':
            direction = 'CE'
        elif STATE['global_sentiment'] == 'BEARISH':
            direction = 'PE'
        else:
            return None

    # 1) Historic pattern (3 pts) — based on the most recent 3-min move
    h_score, h_wins, h_n = historic_pattern_score(kite, stock, last_candle_pct, direction)
    components['historic']      = h_score
    components['historic_wins'] = int(h_wins)
    components['historic_n']    = int(h_n)

    # 2) Sentiment alignment (2 pts)
    sent = STATE['global_sentiment']
    if (sent == 'BULLISH' and direction == 'CE') or \
       (sent == 'BEARISH' and direction == 'PE'):
        components['sentiment'] = 2
    elif sent == 'NEUTRAL':
        components['sentiment'] = 1
    else:
        components['sentiment'] = 0

    # 3) Volume vs 20-day avg — v2 FIX B: same-time-of-day comparison
    # OLD BUG: took 10-min today, multiplied by (375/10) to estimate full day,
    # compared to 20-day full-day average. Broken because morning volume is
    # front-loaded and doesn't scale linearly to full day.
    # NEW: today's cumulative volume up to now vs. cumulative volume by same
    # time-of-day averaged over last 20 sessions. Direct, honest comparison.
    try:
        # Get 20 days of 3-min candles (same interval as today)
        df_intra20 = fetch_kite(kite, stock['token'], days=25, interval='3minute')
        if df_intra20 is not None and not df_intra20.empty:
            # Get current time-of-day marker (minutes since 09:15)
            now_time = datetime.datetime.now().time()
            # Cumulative volume today up to now
            today_cum = float(df_today['volume'].sum())
            # Cumulative volume by this time-of-day for each historical day
            prev_days = df_intra20[df_intra20.index.date < today].copy()
            prev_days['time_of_day'] = prev_days.index.time
            prev_days['date'] = prev_days.index.date
            # Filter to only bars where time <= now_time (matching today's elapsed window)
            same_window = prev_days[prev_days['time_of_day'] <= now_time]
            if not same_window.empty:
                # Cumulative volume by end of same window per day, then average
                per_day_cum = same_window.groupby('date')['volume'].sum()
                # Use last 20 days
                per_day_cum = per_day_cum.tail(20)
                if len(per_day_cum) >= 5:  # need at least 5 days for meaningful avg
                    avg_same_time = float(per_day_cum.mean())
                    ratio = today_cum / avg_same_time if avg_same_time > 0 else 0
                    components['volume_ratio'] = round(ratio, 2)
                    if ratio >= B2['VOLUME_STRONG_MULT']:
                        components['volume'] = 2
                    elif ratio >= 1.0:
                        components['volume'] = 1
                    else:
                        components['volume'] = 0
    except Exception:
        components['volume'] = 0

    # 4) Sector alignment (1 pt)
    sector = stock['sector']
    rep_symbol = SECTOR_REPRESENTATIVE.get(sector)
    if rep_symbol and rep_symbol != sym:
        rep_stock = next((s for s in STATE['universe'] if s['symbol'] == rep_symbol), None)
        if rep_stock:
            try:
                rep_df = fetch_kite(kite, rep_stock['token'], days=2, interval='5minute')
                if rep_df is not None and not rep_df.empty:
                    rep_today = rep_df[rep_df.index.date == today]
                    rep_prev = rep_df[rep_df.index.date < today]
                    if not rep_today.empty and not rep_prev.empty:
                        rep_pct = (float(rep_today['close'].iloc[-1]) -
                                   float(rep_prev['close'].iloc[-1])) / \
                                  float(rep_prev['close'].iloc[-1]) * 100
                        components['rep_pct'] = round(rep_pct, 2)
                        if (direction == 'CE' and rep_pct > 0.3) or \
                           (direction == 'PE' and rep_pct < -0.3):
                            components['sector'] = 1
            except Exception:
                pass
    elif rep_symbol == sym:
        components['sector'] = 1  # we ARE the rep — credit the alignment

    total = sum([components['historic'], components['sentiment'],
                 components['volume'], components['sector']])

    return {
        'symbol':     sym,
        'token':      stock['token'],
        'sector':     stock['sector'],
        'direction':  direction,
        'score':      total,
        'components': components,
        'move_pct':   round(move_pct, 2),
        'last_close': last_close,
        'ts':         datetime.datetime.now().isoformat(),
    }


