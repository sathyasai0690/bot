# SECTION 13 — POSITION MONITOR
# ═══════════════════════════════════════════════════════════════════════
def monitor_position(kite, pos_id):
    """
    Per-position monitor thread. Watches PnL every 3 sec, applies:
      - Target Rs.1,000 + trail (Rs.500 lock initial, +50 per +50 peak)
      - Hard SL Rs.2,000
      - 15-min rule: didn't hit target → exit at any PnL
      - Loss > Rs.1,000 AND live score < entry score → exit
      - 15:15 square-off
    """
    pos = STATE['positions'][pos_id]
    log.info('Monitor START: ' + pos['symbol'] + ' qty=' + str(pos['qty'])
             + ' entry=' + str(pos['entry_price']))

    while pos_id in STATE['positions']:
        try:
            now = datetime.datetime.now()
            elapsed_secs = (now - pos['entry_time']).total_seconds()

            # Fetch latest option LTP
            quote = kite.quote(['NFO:' + pos['symbol']])
            ltp = quote['NFO:' + pos['symbol']].get('last_price')
            if not ltp:
                time.sleep(3)
                continue
            pos['current_ltp'] = ltp
            pnl = (ltp - pos['entry_price']) * pos['qty']
            pos['current_pnl'] = pnl
            if pnl > pos.get('peak_pnl', 0):
                pos['peak_pnl'] = pnl

            target  = B2['TARGET_PROFIT']
            sl      = B2['HARD_STOP_LOSS']
            t_lock  = B2['TRAIL_INITIAL_LOCK']
            t_step  = B2['TRAIL_STEP']

            # --- Trail lock adjustment ---
            if pos['peak_pnl'] >= target:
                # initial trail lock = peak - (target - initial_lock) - then steps
                # peak 1000 → lock 500
                # peak 1050 → lock 1000
                # peak 1100 → lock 1050
                # peak X    → lock (X - 50)  for X >= 1050
                if pos['peak_pnl'] >= target + t_step:
                    pos['trail_lock'] = pos['peak_pnl'] - t_step
                else:
                    pos['trail_lock'] = t_lock

            # --- Exit checks (priority order) ---
            exit_reason = None

            # 1. Hard SL
            if pnl <= -sl:
                exit_reason = 'Hard SL Rs.' + str(sl)

            # 2. Trail lock breached
            elif pos.get('trail_lock') is not None and pnl < pos['trail_lock']:
                exit_reason = ('Trail lock breached  peak=Rs.'
                               + str(int(pos['peak_pnl']))
                               + ' lock=Rs.' + str(int(pos['trail_lock'])))

            # 3. 15-min rule
            elif elapsed_secs >= B2['TIME_EXIT_SECS']:
                if pos['peak_pnl'] < target:
                    exit_reason = '15-min didnt hit target — exit at any PnL'
                else:
                    # had hit target then trailed back — already caught above
                    pass

            # 4. Loss > Rs.1,000 + score drop
            elif pnl < B2['TIME_EXIT_LOSS_FLOOR'] and elapsed_secs >= 180:
                # Re-check score live (cheap: read from STATE)
                cur = STATE['all_scores'].get(pos['stock_name'])
                if cur and cur['score'] < pos['entry_score']:
                    exit_reason = ('Loss>Rs.1000 + score dropped '
                                   + str(pos['entry_score']) + '→' + str(cur['score']))

            # 5. Square-off time
            elif now.time() >= datetime.datetime.strptime(
                    B2['SQUAREOFF_TIME'], '%H:%M').time():
                exit_reason = 'Square-off 15:15'

            if exit_reason:
                close_position(kite, pos_id, exit_reason)
                return

            time.sleep(3)
        except Exception as e:
            log.warning('Monitor error ' + pos['symbol'] + ': ' + str(e))
            time.sleep(5)


def close_position(kite, pos_id, reason):
    """Close out a position and log it."""
    if pos_id not in STATE['positions']:
        return
    pos = STATE['positions'][pos_id]
    try:
        quote = kite.quote(['NFO:' + pos['symbol']])
        exit_ltp = quote['NFO:' + pos['symbol']].get('last_price', pos['current_ltp'])
    except Exception:
        exit_ltp = pos.get('current_ltp', pos['entry_price'])

    success, fill = place_sell(kite, pos['symbol'], pos['qty'], exit_ltp)
    if not success:
        log.error('CLOSE FAILED: ' + pos['symbol'])
        return

    realized_pnl = (fill - pos['entry_price']) * pos['qty']
    pos['exit_time']   = datetime.datetime.now()
    pos['exit_ltp']    = fill
    pos['realized_pnl'] = realized_pnl
    pos['reason']      = reason

    STATE['closed_trades_today'].append(pos.copy())
    STATE['closed_pnl_today'] += realized_pnl

    # v2 FIX D: record outcome-specific cooldown
    if realized_pnl > 0:
        STATE['last_exit_win'][pos['stock_name']] = datetime.datetime.now()
        STATE['consecutive_sl_count'] = 0
    else:
        STATE['last_exit_loss'][pos['stock_name']] = datetime.datetime.now()
        STATE['consecutive_sl_count'] += 1

    log.info('═════ EXIT  ' + pos['symbol']
             + '  PnL=Rs.' + str(round(realized_pnl, 2))
             + '  reason: ' + reason)
    del STATE['positions'][pos_id]

    # Update Excel report
    write_excel_report()


# ═══════════════════════════════════════════════════════════════════════
# SECTION 14 — TRADE ENTRY LOOP
# ═══════════════════════════════════════════════════════════════════════
def can_enter_new_trade():
    """Check if we're allowed to enter another trade right now."""
    now = datetime.datetime.now().time()
    if not (B2['TRADE_START'] <= now <= B2['TRADE_END']):
        return False, 'outside trade window'
    if len(STATE['positions']) >= B2['MAX_PARALLEL']:
        return False, 'at max parallel (' + str(B2['MAX_PARALLEL']) + ')'
    if B2['CONSECUTIVE_SL_LIMIT'] > 0 and \
       STATE['consecutive_sl_count'] >= B2['CONSECUTIVE_SL_LIMIT']:
        return False, 'consecutive SL limit hit'
    if B2['DAILY_MAX_LOSS'] < 0 and \
       STATE['closed_pnl_today'] <= B2['DAILY_MAX_LOSS']:
        return False, 'daily SL hit'
    return True, ''


def trade_loop(kite):
    """Main trade loop. Runs every 3 min."""
    if not STATE['pre_market_done']:
        return
    can, why = can_enter_new_trade()
    if not can:
        return

    # Find best qualifying pick that's not already in a position
    open_stocks = {p['stock_name'] for p in STATE['positions'].values()}

    # v2 FIX D: outcome-specific cooldowns
    cooldown_win_secs  = B2['SAME_STOCK_COOLDOWN_WIN_SECS']   # 5 min after win
    cooldown_loss_secs = B2['SAME_STOCK_COOLDOWN_LOSS_SECS']  # 60 min after loss
    now = datetime.datetime.now()

    for pick in STATE['top_picks']:
        sym = pick['symbol']
        if pick['score'] < B2['MIN_ENTRY_SCORE']:
            break  # sorted DESC — no point continuing
        if sym in open_stocks:
            continue
        # v2 FIX D: check cooldown based on last outcome
        last_loss = STATE['last_exit_loss'].get(sym)
        if last_loss and (now - last_loss).total_seconds() < cooldown_loss_secs:
            continue  # still in loss-cooldown (60 min)
        last_win = STATE['last_exit_win'].get(sym)
        if last_win and (now - last_win).total_seconds() < cooldown_win_secs:
            continue  # still in win-cooldown (5 min)

        # Try to enter this one
        enter_trade(kite, pick)
        return  # one entry per scan cycle (max)

    log.info('No qualifying pick (top score=' +
             str(STATE['top_picks'][0]['score'] if STATE['top_picks'] else 0)
             + ', need >=' + str(B2['MIN_ENTRY_SCORE']) + ')')


def enter_trade(kite, pick):
    """Find a tradeable option strike and enter."""
    sym = pick['symbol']
    direction = pick['direction']
    log.info('─' * 50)
    log.info('ENTRY ATTEMPT: ' + sym + ' ' + direction
             + ' score=' + str(pick['score']) + ' ' + str(pick['components']))

    # v2 FIX F: IV rank check — skip when options are too expensive
    iv_rank = STATE.get('iv_rank', 50)
    if iv_rank > B2['MAX_IV_RANK_ENTRY']:
        log.info('  Skip: IV rank ' + str(iv_rank)
                 + ' > ' + str(B2['MAX_IV_RANK_ENTRY'])
                 + ' — options too expensive.')
        return

    opt = find_option_symbol(kite, sym, direction)
    if not opt:
        log.info('  No tradeable option strike for ' + sym + '.')
        return

    # Sizing — fit within PER_TRADE_MAX_RISK
    lot_cost = opt['opt_ltp'] * opt['lot_size']
    max_capital = B2['PER_TRADE_MAX_RISK']
    max_lots = int(max_capital / lot_cost) if lot_cost > 0 else 0
    if max_lots < 1:
        log.info('  Skipping ' + opt['symbol'] + ' — single lot Rs.'
                 + str(round(lot_cost)) + ' > per-trade cap Rs.' + str(max_capital))
        return
    qty = max_lots * opt['lot_size']

    success, fill_price = place_buy(kite, opt['symbol'], qty, opt['opt_ltp'])
    if not success:
        log.warning('  BUY failed for ' + opt['symbol'])
        return

    pos_id = opt['symbol'] + '_' + datetime.datetime.now().strftime('%H%M%S')
    pos = {
        'pos_id':       pos_id,
        'symbol':       opt['symbol'],
        'stock_name':   sym,
        'direction':    direction,
        'strike':       opt['strike'],
        'qty':          qty,
        'lot_size':     opt['lot_size'],
        'entry_price':  fill_price,
        'entry_time':   datetime.datetime.now(),
        'entry_score':  pick['score'],
        'entry_components': dict(pick['components']),
        'cost':         round(fill_price * qty, 2),
        'current_ltp':  fill_price,
        'current_pnl':  0,
        'peak_pnl':     0,
        'trail_lock':   None,
    }
    STATE['positions'][pos_id] = pos
    log.info('═════ ENTERED  ' + pos['symbol']
             + '  qty=' + str(qty) + '  fill=Rs.' + str(fill_price)
             + '  cost=Rs.' + str(pos['cost']))

    # Start a monitor thread
    t = threading.Thread(target=monitor_position, args=(kite, pos_id),
                         daemon=True, name='Mon-' + pos_id)
    t.start()


