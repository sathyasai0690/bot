def build_universe(kite):
    """
    Build the fresh universe of tradeable stocks for today.
    Filters: in NIFTY F&O + sector_map + affordable at Rs.40K.
    """
    log.info('Building fresh universe...')
    try:
        instruments = kite.instruments('NSE')
    except Exception as e:
        log.error('Failed to load NSE instruments: ' + str(e))
        return []

    sym_to_token = {}
    for inst in instruments:
        if inst['segment'] == 'NSE' and inst['instrument_type'] == 'EQ':
            sym_to_token[inst['tradingsymbol']] = inst['instrument_token']

    universe = []
    for symbol, sector in SECTOR_MAP.items():
        token = sym_to_token.get(symbol)
        if not token:
            log.warning('Symbol not found in NSE instruments: ' + symbol)
            continue
        # Check affordability (need at least 1 lot worth < per_trade_max)
        ltp = get_ltp_safe(kite, 'NSE:' + symbol)
        if not ltp or ltp <= 0:
            continue
        universe.append({
            'symbol': symbol,
            'token': token,
            'sector': sector,
            'ltp': ltp,
        })
        time.sleep(0.1)  # gentle rate limit

    log.info('Universe ready: ' + str(len(universe)) + ' stocks')
    return universe


